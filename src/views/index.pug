doctype html
html.page(lang="ru")
	head
		meta(charset="UTF-8")
		meta(name="viewport" content="width=device-width, initial-scale=1.0")
		title Only-task
		link(href='../scss/main.scss' rel='stylesheet')
	body.page__body
		header.main-header
			.main-header__bg
			.main-header__container
				nav.main-header__nav.main-nav
					a.main-nav__logo(href='#')
						.
							<svg xmlns="http://www.w3.org/2000/svg" width="21" height="20" fill="none" viewBox="0 0 21 20">
							<path fill="currentColor" d="M10.09 19.64C4.526 19.64 0 15.237 0 9.82 0 4.405 4.526 0 10.09 0s10.09 4.405 10.09 9.82c-.002 5.416-4.528 9.82-10.09 9.82m0-18.262c-4.782 0-8.675 3.788-8.675 8.442 0 4.655 3.893 8.443 8.675 8.443s8.675-3.788 8.675-8.443c-.003-4.654-3.893-8.442-8.675-8.442"/>
							</svg>
						span Forrest
					ul.main-nav__list
						li.main-nav__list-item
							a.main-nav__list-link(href='#') Услуги
						li.main-nav__list-item
							a.main-nav__list-link(href='#') Поддержка
						li.main-nav__list-item
							a.main-nav__list-link(href='#') Компания
						li.main-nav__list-item
							a.main-nav__list-link(href='#') Партнеры
						li.main-nav__list-item
							a.main-nav__list-link(href='#') Портфолио
						li.main-nav__list-item
							a.main-nav__list-link(href='#') Контакты
				button.main-header__button.button(type='button')
					span.visually-hidden Открыть меню
					span.button__line
					span.button__line
					span.button__line
					span.button__line
			article.main-header__hero.hero
				h1.hero__title.title
					span.hero__title-line
						span.hero__title-text Превращаем окружение
					span.hero__title-line
						span.hero__title-text #[span.title--accent в живые сады]
				p.hero__text Вертикальное озеленение для бизнеса. Преображаем бизнес центры, ТЦ, отели, рестораны и другие коммерческие помещения.
		main.page__main.main-container
			section.main-container__about-product.about-product
				h2.about-product__title.secondary-title
					span.about-product__title-line
						span.about-product__title-text #[span.secondary-title--accent Достаточно]найти
					span.about-product__title-line
						span.about-product__title-text одну опорную стену
				.about-product__text-wrapper
					p.about-product__text Вертикальное озеленение – это&nbsp;инновационный способ интеграции природы в&nbsp;городскую среду.
					p.about-product__text Эти&nbsp;живые конструкции, состоящие из&nbsp;растений, закреплённых на&nbsp;вертикальных поверхностях, не&nbsp;только преображают внешний вид&nbsp;зданий и&nbsp;интерьеров, но&nbsp;и&nbsp;приносят ощутимую пользу: улучшают качество воздуха, снижают температуру окружающей среды, создают звукоизоляцию и, конечно, дарят эстетическое удовольствие, превращая бетонные стены в&nbsp;цветущие оазисы.
		footer.page__footer.footer-page
			section.footer-page__consultation.consultation
				.consultation__content-wrapper
					.consultation__content-inner
						h2.consultation__title.secondary-title
							span.consultation__title-line
								span.consultation__title-text #[span.secondary-title--accent Ежемесячная]
							span.consultation__title-line
								span.consultation__title-text поддержка от нас
						p.consultation__text Ежемесячно проверяем состояние растений, бережно чистим от пыли и при необходимости заменяем растения.
					span.consultation__button-line
						button.consultation__button(type='button') Консультация
				picture.consultation__picture-wrap
					source(
						type='image/webp'
						srcset='../assets/images/footer/hanging-gardens-footer@1x.webp 1x, ../assets/images/footer/hanging-gardens-footer@2x.webp 2x'
						)
					img.consultation__picture(
						src='../assets/images/footer/hanging-gardens-footer@1x.jpg'
						srcset='../assets/images/footer/hanging-gardens-footer@2x.jpg 2x'
						width='960'
						height='700'
						alt='Висящие сады'
						loading='lazy'
						)
		//- Подключаем TypeScript напрямую (без require)
		script(src='../ts/main.ts')
